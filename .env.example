# Sao chép file này thành .env (không commit .env — đã có trong .gitignore)
# và điền giá trị thật.

# Token bot Telegram, lấy từ @BotFather khi tạo bot (VD @Tintucstock_bot)
TELEGRAM_BOT_TOKEN=

# Chat ID nhận bản tin — KHÔNG cần điền tay: chạy
#   python3 notifications/telegram.py whoami
# sau khi đã bấm /start với bot, script sẽ tự lấy và ghi vào .env
TELEGRAM_CHAT_ID=
